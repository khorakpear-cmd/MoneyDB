rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny-All Catch-All (First pillar)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTransaction(data, expectedUserId) {
      return data.userId is string &&
             data.userId == expectedUserId &&
             (data.type == 'income' || data.type == 'expense') &&
             data.amount is number &&
             data.amount > 0 &&
             data.amount < 1000000000 &&
             data.category is string &&
             data.category.size() > 0 &&
             data.category.size() <= 64 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 255)) &&
             data.date is string &&
             data.date.size() == 10 &&
             (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50));
    }

    // Allow test connection check
    match /test/connection {
      allow get: if true;
    }

    // User Transactions Subcollection
    match /users/{userId}/transactions/{transactionId} {
      allow get: if isOwner(userId) && isValidId(transactionId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(transactionId) &&
                       isValidTransaction(incoming(), userId);
      allow update: if isOwner(userId) &&
                       isValidId(transactionId) &&
                       isValidTransaction(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'amount', 'type', 'category', 'description', 'date', 'paymentMethod', 'updatedAt'
                       ]);
      allow delete: if isOwner(userId) && isValidId(transactionId);
    }
  }
}
